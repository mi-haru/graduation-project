<main class="medisu-page px-6 py-8">
  <%= render "shared/page_decorations" %>

  <div class="relative mx-auto max-w-6xl">
    <header class="flex items-center gap-3">
      <%= image_tag "logo.png",
                    alt: "medi巣のロゴ",
                    class: "h-12 w-12 rounded-full object-cover" %>

      <span class="text-2xl font-bold text-[#4a654f]">
        medi巣
      </span>
    </header>

    <div class="grid items-center gap-12 py-16 md:grid-cols-2 md:py-24">
      <section>
        <p class="mb-4 text-sm font-bold tracking-wider text-[#715a3e]">
          健康情報が帰る場所
        </p>

        <h1 class="text-4xl font-bold leading-tight tracking-tight text-[#253f2b] md:text-6xl">
          服薬と通院を、<br>
          ひとつの巣に。
        </h1>

        <div class="mt-6 space-y-2 leading-8 text-[#424842]">
          <p>
            今日飲む薬も、次の受診予定も、ここを見ればすぐ分かる。
          </p>

          <p>
            medi巣は、毎日の健康管理をやさしく支える場所です。
          </p>
        </div>

        <div class="mt-8 flex flex-wrap gap-4">
          <%= link_to "新規登録",
            new_user_registration_path,
            class: "rounded-full bg-[#4a654f] px-8 py-4 font-bold text-white transition hover:bg-[#3c5341]" %>

          <%= link_to "ログイン",
            new_user_session_path,
            class: "rounded-full border border-[#4a654f]/30 bg-[#fff8f3] px-8 py-4 font-bold text-[#4a654f] transition hover:bg-[#f0e7dc]" %>

        </div>

      </section>

      <section class="medisu-card p-7">
        <div class="absolute -right-12 -top-14 h-36 w-36 rounded-full bg-[#f0e7dc]/70"></div>

        <div class="relative mb-6 flex items-center gap-4">
          <%= image_tag "logo.png",
                        alt: "",
                        class: "h-14 w-14 rounded-full object-cover",
                        aria: { hidden: true } %>

          <div>
            <p class="text-sm font-bold text-[#737972]">
              medi巣でできること
            </p>

            <h2 class="text-xl font-bold text-[#253f2b]">
              毎日の安心をひとまとめに
            </h2>
          </div>
        </div>

        <div class="relative space-y-3">
          <div class="flex items-center gap-4 rounded-[1.75rem] bg-[#fff8f3] p-4">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-[#cceacf] text-xl font-bold text-[#334d38]">
              ＋
            </span>

            <div class="flex-1">
              <h3 class="font-bold">今日の服薬</h3>
              <p class="text-sm text-[#737972]">飲む薬とタイミングを確認</p>
            </div>

            <span class="font-bold text-[#4a654f]">✓</span>
          </div>

          <div class="flex items-center gap-4 rounded-[1.75rem] bg-[#fff8f3] p-4">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-[#cceacf] text-xl font-bold text-[#334d38]">
              ✓
            </span>

            <div class="flex-1">
              <h3 class="font-bold">服薬チェック</h3>
              <p class="text-sm text-[#737972]">飲んだ記録をかんたんに</p>
            </div>

            <span class="font-bold text-[#4a654f]">✓</span>
          </div>

          <div class="flex items-center gap-4 rounded-[1.75rem] bg-[#fff8f3] p-4">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-[#cceacf] text-xl font-bold text-[#334d38]">
              □
            </span>

            <div class="flex-1">
              <h3 class="font-bold">次回の受診予定</h3>
              <p class="text-sm text-[#737972]">通院日時をいつでも確認</p>
            </div>

            <span class="font-bold text-[#4a654f]">✓</span>
          </div>
        </div>
      </section>
    </div>
  </div>
</main>
