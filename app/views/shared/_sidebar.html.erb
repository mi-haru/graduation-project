<aside class="medisu-card flex flex-col p-6 lg:min-h-[calc(100vh-3rem)]">
  <div>
    <%= link_to home_path, class: "inline-block" do %>
      <%= image_tag "logo.png",
                    alt: t("sidebar.logo_alt"),
                    class: "h-16 w-auto" %>
    <% end %>

    <div class="mt-8">
      <h2 class="text-2xl font-bold text-[#344a39]">
        <%= t("sidebar.welcome") %>
      </h2>

      <p class="mt-2 text-sm leading-6 text-gray-600">
        <%= t("sidebar.greeting", nickname: current_user.nickname) %><br>
        <%= t("sidebar.description") %>
      </p>
    </div>

    <nav class="mt-8 space-y-3" aria-label="<%= t('sidebar.navigation_label') %>">
      <%= link_to home_path,
                  class: "block rounded-2xl px-5 py-4 font-bold transition #{current_page?(home_path) ? 'bg-[#8daa91] text-white' : 'text-[#344a39] hover:bg-[#edf5ee]'}" do %>
        <%= t("sidebar.home") %>
      <% end %>

      <%= link_to medications_path,
                  class: "block rounded-2xl px-5 py-4 font-bold transition #{current_page?(medications_path) ? 'bg-[#8daa91] text-white' : 'text-[#344a39] hover:bg-[#edf5ee]'}" do %>
        <%= t("sidebar.medications") %>
      <% end %>

      <%= link_to appointments_path,
                  class: "block rounded-2xl px-5 py-4 font-bold transition #{controller_name == 'appointments' ? 'bg-[#8daa91] text-white' : 'text-[#344a39] hover:bg-[#edf5ee]'}" do %>
        <%= t("sidebar.appointments") %>
      <% end %>
    </nav>
  </div>

  <div class="mt-8 border-t border-[#4a654f]/10 pt-5 lg:mt-auto">
    <%= button_to t("sidebar.logout"),
                  destroy_user_session_path,
                  method: :delete,
                  form: { class: "w-full" },
                  class: "w-full rounded-2xl border border-[#4a654f]/20 px-5 py-3 text-left font-bold text-[#4a654f] transition hover:bg-[#f0e7dc]" %>
  </div>
</aside>