<header class="mb-6 px-2 py-3">
  <h1 class="text-3xl font-bold text-[#1f1b15] sm:text-4xl">
    今日の状況
  </h1>

  <p class="mt-2 text-gray-600">
    <%= I18n.l(@today, format: "%-m月%-d日") %>
    ・穏やかな一日になりますように
  </p>
</header>

<div class="grid gap-6 xl:grid-cols-[minmax(0,1.4fr)_minmax(18rem,0.9fr)]">
  <%= render "today_medications" %>

  <div class="space-y-6">
    <%= render "next_appointment" %>

    <section class="rounded-[3rem] bg-[#4a654f] p-8 text-center text-white shadow-xl shadow-[#715a3e]/10">
      <p class="text-3xl" aria-hidden="true">
        ❀
      </p>

      <p class="mt-3 text-lg font-bold">
        少しずつ、自分のペースで。
      </p>
    </section>
  </div>
</div>

