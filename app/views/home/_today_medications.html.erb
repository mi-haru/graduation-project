<section class="medisu-card p-7 sm:p-9">
  <h2 class="text-2xl font-bold text-[#344a39]">
    <%= t("home.medications.title") %>
  </h2>

  <p class="mt-3 text-sm leading-6 text-gray-600">
    <%= t("home.medications.instruction") %>
  </p>

  <% if @timings_by_time_period.any? %>
    <div class="mt-7 space-y-7">
      <% @timings_by_time_period.each do |period, timings| %>
        <section>
          <h3 class="mb-3 font-bold text-[#344a39]">
            <%= period.name %>
          </h3>

          <div class="space-y-3">
            <%= render partial: "home/medication_timing",
                       collection: timings,
                       as: :timing %>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <div class="mt-7 rounded-3xl bg-[#fff8f3] p-6">
      <p class="font-bold text-[#344a39]">
        <%= t("home.medications.empty_title") %>
      </p>

      <p class="mt-2 text-sm leading-6 text-gray-600">
        <%= t("home.medications.empty_description") %>
      </p>
    </div>
  <% end %>

  <%= link_to t("home.medications.register"),
              new_medication_path,
              class: "mt-6 block rounded-full bg-[#4a654f] px-6 py-3 text-center font-bold text-white transition hover:bg-[#3c5341]" %>
</section>