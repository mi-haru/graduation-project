<header class="mb-6 flex flex-wrap items-end justify-between gap-4 px-2 py-3">
  <div>
    <p class="text-sm font-bold text-[#8daa91]">
      <%= t("medications.heading") %>
    </p>

    <h1 class="mt-2 text-3xl font-bold text-[#1f1b15] sm:text-4xl">
      <%= t("medications.index.title") %>
    </h1>

    <p class="mt-2 text-gray-600">
      <%= t("medications.index.description") %>
    </p>
  </div>

  <%= link_to t("medications.index.register"),
              new_medication_path,
              class: "rounded-full bg-[#4a654f] px-7 py-3 font-bold text-white transition hover:bg-[#3c5341]" %>
</header>

<% if @medications.any? %>
  <div class="grid gap-5">
    <% @medications.each do |medication| %>
      <%= render @medications %>
    <% end %>
  </div>
<% else %>
  <section class="medisu-card p-8 text-center sm:p-12">
    <p class="text-4xl" aria-hidden="true">
      ＋
    </p>

    <h2 class="mt-4 text-2xl font-bold text-[#344a39]">
      <%= t("medications.index.empty_title") %>
    </h2>

    <p class="mt-3 text-gray-600">
      <%= t("medications.index.empty_description") %>
    </p>

    <%= link_to t("medications.index.register"),
                new_medication_path,
                class: "mt-6 inline-block rounded-full bg-[#4a654f] px-8 py-3 font-bold text-white transition hover:bg-[#3c5341]" %>
  </section>
<% end %>