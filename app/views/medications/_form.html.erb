<section class="medisu-card p-7 sm:p-9">
  <% if @medication.errors.any? %>
    <div
      role="alert"
      class="mb-7 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-red-700"
    >
      <p class="font-bold">
         <%= t("medications.form.error_heading") %>
      </p>

      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% @medication.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @medication, class: "space-y-8" do |form| %>
    <div>
      <%= form.label :name,
                     class: "ml-2 block font-bold text-[#344a39]" %>

      <%= form.text_field :name,
                          required: true,
                          placeholder: t("medications.form.name_placeholder"),
                          autocomplete: "off",
                          class: "mt-2 w-full rounded-[1.25rem] border border-transparent bg-[#4a654f]/5 px-6 py-4 outline-none transition focus:border-[#715a3e] focus:ring-4 focus:ring-[#fdddb9]/50" %>
    </div>

    <div>
      <%= form.label :dosage,
                     class: "ml-2 block font-bold text-[#344a39]" %>

      <%= form.text_field :dosage,
                          required: true,
                          placeholder: t("medications.form.dosage_placeholder"),
                          autocomplete: "off",
                          class: "mt-2 w-full rounded-[1.25rem] border border-transparent bg-[#4a654f]/5 px-6 py-4 outline-none transition focus:border-[#715a3e] focus:ring-4 focus:ring-[#fdddb9]/50" %>
    </div>

    <fieldset>
      <legend class="ml-2 font-bold text-[#344a39]">
        <%= t("medications.form.meal_timing_label") %>
      </legend>

      <div class="mt-3 flex flex-wrap gap-3">
        <% MedicationTiming.meal_timings.keys.each do |value| %>
          <label class="cursor-pointer">
            <%= radio_button_tag "medication[meal_timing]",
                                 value,
                                 @meal_timing == value,
                                 id: "medication_meal_timing_#{value}",
                                 class: "peer sr-only" %>

            <span class="block rounded-full border border-[#4a654f]/20 bg-[#fcf2e7] px-6 py-3 font-bold text-[#344a39] transition peer-checked:border-[#4a654f] peer-checked:bg-[#4a654f] peer-checked:text-white">
              <%= t("enums.medication_timing.meal_timing.#{value}") %>
            </span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <fieldset>
      <legend class="ml-2 font-bold text-[#344a39]">
        <%= t("medications.form.time_period_label") %>
      </legend>

      <p class="ml-2 mt-1 text-sm text-gray-600">
        <%= t("medications.form.time_period_hint") %>
      </p>

      <div class="mt-3 flex flex-wrap gap-3">
        <% @time_periods.each do |period| %>
          <label class="cursor-pointer">
            <%= check_box_tag "medication[time_period_ids][]",
                              period.id,
                              @selected_time_period_ids.include?(period.id.to_s),
                              id: "time_period_#{period.id}",
                              class: "peer sr-only" %>

            <span class="block rounded-full border border-[#4a654f]/20 bg-[#fcf2e7] px-6 py-3 font-bold text-[#344a39] transition peer-checked:border-[#4a654f] peer-checked:bg-[#4a654f] peer-checked:text-white">
              <%= period.name %>
            </span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <%= form.label :start_date,
                       class: "ml-2 block font-bold text-[#344a39]" %>

        <%= form.date_field :start_date,
                            required: true,
                            class: "mt-2 w-full rounded-[1.25rem] border border-transparent bg-[#4a654f]/5 px-6 py-4 outline-none transition focus:border-[#715a3e] focus:ring-4 focus:ring-[#fdddb9]/50" %>
      </div>

      <div>
        <%= form.label :end_date,
                       t("medications.form.end_date_optional"),
                       class: "ml-2 block font-bold text-[#344a39]" %>

        <%= form.date_field :end_date,
                            class: "mt-2 w-full rounded-[1.25rem] border border-transparent bg-[#4a654f]/5 px-6 py-4 outline-none transition focus:border-[#715a3e] focus:ring-4 focus:ring-[#fdddb9]/50" %>
      </div>
    </div>

    <div class="flex flex-col-reverse gap-3 pt-2 sm:flex-row sm:justify-end">
      <%= link_to t("actions.cancel"),
                  medications_path,
                  class: "rounded-full border border-[#4a654f]/30 px-8 py-4 text-center font-bold text-[#344a39] transition hover:bg-[#f0e7dc]" %>

      <%= form.submit t(@medication.persisted? ? "actions.update" : "actions.create"),
                      class: "cursor-pointer rounded-full bg-[#4a654f] px-10 py-4 font-bold text-white shadow-lg shadow-[#715a3e]/10 transition hover:bg-[#3c5341]" %>
    </div>
  <% end %>
</section>